@model Satluj_Latest.Models.HealthModel

@{
    ViewBag.Title = "Health";
    Layout = "~/Views/Shared/_SchoolAdminLayout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <h3 style="margin-top: 5px;">HEALTH & ATTENDANCE</h3>

        <div class="row" style="margin-left:15px !important;">
            @Html.HiddenFor(z => z.SchoolId)
            @Html.HiddenFor(z => z.DivisionId, new { Value = 0 })
            @Html.HiddenFor(z => z.PeriodId, new { Value = 0 })
            @Html.HiddenFor(z => z.ClassId, new { Value = 0 })

            <div class="row">
                <div class="form-group col-sm-3">
                    <div class="form-group">
                        <label>Class :</label>
                        <br />
                        <select asp-for="ClassId"
                                asp-items="ViewBag.classlist"
                                class="form-control pv_class-drop-down class-drop-down"
                                data-live-search="true"
                                id="classDataDropdown">
                            <option value="">--Choose--</option>
                        </select>
                        <span asp-validation-for="ClassId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group col-sm-3">
                    <label>Division</label>
                    <br />
                    <select id="division-drop-down" class="form-control slct-free-div-dropdown" disabled>
                        <option value="">--Select Division --</option>
                    </select>
                    <span id="spn-error-Division" style="color:red;"></span>
                </div>

                <div class="form-group col-sm-3">
                    <div class="form-group">
                        <label>Periods :</label>
                        <br />
                        <select id="period-drop-down" class="form-control slct-free-period-dropdown" disabled>
                            <option value="">--Select Periods --</option>
                        </select>
                        <span id="spn-error-Period" style="color:red;"></span>
                    </div>
                </div>

                <div class="form-group col-sm-3">
                    <div class="form-group">
                        <label></label><br />
                        <button class="btn pay-now-btn" style="margin-top: 9%;" id="btn-search" type="button">
                            <i class="fa fa-save"></i> Search
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive" id="academicAreaList"></div>
    </div>
</div>

<script>
    //---------------------------------------------
    // CLASS CHANGE → LOAD DIVISION + PERIODS
    //---------------------------------------------
    $(document).on('change', '.class-drop-down', function () {

        var classId = $(this).val();
        $('#ClassId').val(classId);

        // reset hidden values
        $('#DivisionId').val('');
        $('#PeriodId').val('');

        // reset dropdowns
        $("#division-drop-down").html('<option value="">-- Select Division --</option>').prop("disabled", true);
        $("#period-drop-down").html('<option value="">-- Select Periods --</option>').prop("disabled", true);
        $('#academicAreaList').html('');

        if (classId !== '') {

            //---------------------------------------------
            // LOAD DIVISIONS
            //---------------------------------------------
            $.ajax({
                url: '/Data/LoadDivision',
                type: "GET",
                data: { id: classId },
                success: function (result) {
                    $("#division-drop-down").html('');

                    if (result.list && result.list.length > 0) {
                        $("#division-drop-down").append('<option value="">-- Select Division --</option>');

                        $.each(result.list, function (i, item) {
                            $("#division-drop-down").append(
                                $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                            );
                        });

                        $("#division-drop-down").prop("disabled", false);
                    }
                    else {
                        $("#division-drop-down").append('<option value="">-- No Division Found --</option>');
                        $("#division-drop-down").prop("disabled", true);
                    }
                },
                error: function () {
                    console.log("Error loading divisions");
                    $("#division-drop-down").html('<option value="">-- No Division Found --</option>').prop("disabled", true);
                }
            });

            //---------------------------------------------
            // LOAD PERIODS
            //---------------------------------------------
            BindPeriods(classId);
        }
        else {
            BindPeriods(0);
        }
    });

    //---------------------------------------------
    // LOAD PERIODS FUNCTION
    //---------------------------------------------
    function BindPeriods(id) {

        if (!id || id == 0) {
            $("#period-drop-down").html('<option value="">-- No Periods Found --</option>').prop("disabled", true);
            return;
        }

        $.ajax({
            url: '/Data/LoadPeriods',
            type: "GET",
            data: { id: id },
            success: function (result) {
                $("#period-drop-down").html('');

                if (result.list && result.list.length > 0) {
                    $("#period-drop-down").append('<option value="">-- Select Periods --</option>');

                    $.each(result.list, function (i, item) {
                        $("#period-drop-down").append(
                            $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                        );
                    });

                    $("#period-drop-down").prop("disabled", false);
                }
                else {
                    $("#period-drop-down").append('<option value="">-- No Periods Found --</option>');
                    $("#period-drop-down").prop("disabled", true);
                }
            },
            error: function () {
                console.log("Error loading periods");
                $("#period-drop-down").html('<option value="">-- No Periods Found --</option>').prop("disabled", true);
            }
        });
    }

    //---------------------------------------------
    // DIVISION CHANGE
    //---------------------------------------------
    $(document).on('change', '.slct-free-div-dropdown', function () {
        $('#DivisionId').val($(this).val());
    });

    //---------------------------------------------
    // PERIOD CHANGE
    //---------------------------------------------
    $(document).on('change', '.slct-free-period-dropdown', function () {
        $('#PeriodId').val($(this).val());
    });

    //---------------------------------------------
    // SEARCH
    //---------------------------------------------
    $(document).on('click', '#btn-search', function () {
        var classId = $('#ClassId').val();
        var divisionId = $('#DivisionId').val();
        var periods = $('#PeriodId').val();

        if (!classId || classId == '0') {
            toastrError('Please select the Class!');
        }
        else if (!divisionId || divisionId == '0') {
            toastrError('Please select the Division!');
        }
        else if (!periods || periods == '0') {
            toastrError('Please select the Periods!');
        }
        else {
            var id = classId + '~' + divisionId + '~' + periods;

            $.ajax({
                url: '/Teacher/SearchStudentsForHealth/' + id,
                type: "GET",
                dataType: 'html',
                success: function (data) {
                    $('#academicAreaList').html(data);
                }
            });
        }
    });

    //---------------------------------------------
    // SAVE HEALTH DATA
    //---------------------------------------------
    $(document).on('click', '#students-helth-Save_btn', function () {
        getFullData();
    });

    function getFullData() {
        var dataList = {
            ClassId: $('#ClassId').val(),
            DivisionId: $('#DivisionId').val(),
            PeriodId: $('#PeriodId').val(),
            _StudentListForHealth: []
        };

        $('.cls-tr-class').each(function () {
            dataList._StudentListForHealth.push({
                StudentId: $(this).attr('data-StudentId'),
                Height: $(this).find('.cls-Height').val(),
                Weight: $(this).find('.cls-Weight').val(),
                WorkingDays: $(this).find('.cls-WorkingDays').val(),
                PresentDays: $(this).find('.cls-PresentDays').val(),
                StudentName: ''
            });
        });

        $.ajax({
            url: "/Teacher/SubmitStudentsHealthDetails",
            type: "POST",
            dataType: 'json',
            data: dataList,
            success: function (response) {
                if (response.status) {
                    toastrSuccess(response.msg);
                    Refresh();
                }
                else {
                    toastrError(response.msg);
                }
            }
        });
    }

    //---------------------------------------------
    // REFRESH AFTER SAVE
    //---------------------------------------------
    function Refresh() {
        var classId = $('#ClassId').val();
        var divisionId = $('#DivisionId').val();
        var periods = $('#PeriodId').val();

        if (!classId || !divisionId || !periods) return;

        var id = classId + '~' + divisionId + '~' + periods;

        $.ajax({
            url: '/Teacher/SearchStudentsForHealth/' + id,
            type: "GET",
            dataType: 'html',
            success: function (data) {
                $('#academicAreaList').html(data);
            }
        });
    }
</script>