@model Satluj_Latest.Models.TimeTable

@{ ViewBag.Title = "SeasonView";
    Layout = "~/Views/Shared/_SchoolAdminLayout.cshtml"; }

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">


<style>
    input#SeasonName {
        font-size: 14px !important;
        font-weight: 500;
        line-height: 1.4;
    }

    table td input[type="date"],
    table td input[type="time"] {
        font-size: 14px !important;
        font-weight: 500;
        line-height: 1.5;
    }
    #seasonForm label{
        font-size: 15px;
    }
    .sea{
        font-size:20px;
    }
</style>


<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0 sea">Add Season</h5>
        </div>

        <div class="card-body">
            <form id="seasonForm">
                <input type="hidden" id="SeasonId" />
                <div class="row ">
                    <div class="col-md-3">
                        <label class="form-label">Season Name</label>
                        <input type="text" id="SeasonName" class="form-control" required>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Start Date</label>
                        <input type="date" id="StartDate" class="form-control" required>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">End Date</label>
                        <input type="date" id="EndDate" class="form-control" required>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Start Time</label>
                        <input type="time" id="StartTime" class="form-control">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">End Time</label>
                        <input type="time" id="EndTime" class="form-control">
                    </div>
                    
                </div>

                <!-- ROW 2 -->
                <div class="row">
                    <div class="col-md-3">
                        <label class="form-label">Break1 Start Time</label>
                        <input type="time" id="BrkSt1Time" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Break1 End Time</label>
                        <input type="time" id="BrkEnd1Time" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Break2 Start Time</label>
                        <input type="time" id="BrkSt2Time" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Break2 End Time</label>
                        <input type="time" id="BrkEnd2Time" class="form-control">
                    </div>
                </div>

                <!-- Buttons -->
                <div class="text-end">
                    <button type="reset" class="btn btn-secondary me-2">Reset</button>
                    <button type="submit" class="btn btn-primary" id="Add-season">Save</button>
                    <button type="submit" class="btn btn-primary" id="Edit-season" onclick="updateSeason(event)">Edit</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Success Alert -->
<div id="successAlert"
     class="alert alert-success alert-dismissible fade d-none mt-3"
     role="alert">
    <strong>Success!</strong> Data saved successfully.
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Success</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-0">Data saved successfully!</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">
                    OK
                </button>
            </div>
        </div>
    </div>
</div>

<table class="table table-bordered mt-4" id="seasonTable">
    <thead class="table-primary">
        <tr>
            <th>Season</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Time</th>
            <th>Break Time1</th>
            <th>Break Time2</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

