@model Satluj_Latest.Models.TimetableModel

<form id="form-add-exam">
    
    <input type="hidden" asp-for="DivisonId" />

    <div class="row">

        <!-- Season -->
        <div class="col-sm-3">
            <label>Season :</label>
            <select asp-for="SeasonId"
                    asp-items="ViewBag.SeasonList"
                    class="form-control">
                <option value="">--Select--</option>
            </select>
        </div>

        <!-- Class -->
        <div class="col-sm-3">
            <label>Class :</label>
            <select asp-for="ClassId"
                    asp-items="ViewBag.ClassList"
                    class="form-control slct-mark-dropdwn1">
                <option value="">--Select--</option>
            </select>
        </div>

        <!-- Division -->
        <div class="col-sm-3">
            <label>Division :</label>
            <select class="form-control slct-free-div-dropdown" disabled></select>
        </div>

        <!-- Teacher -->
        <div class="col-sm-3">
            <label>Teacher :</label>
            <select asp-for="TeacherId"
                    asp-items="ViewBag.TeacherList"
                    class="form-control">
                <option value="">--Select--</option>
            </select>
        </div>

    </div>

    <div class="row">

        <!-- Subject -->
        <div class="col-sm-3">
            <label>Subject :</label>
            <select asp-for="SubjectId"
                    asp-items="ViewBag.SubjectList"
                    class="form-control"
                    id="subject-drop-id">
                <option value="">-- Select Subject --</option>
            </select>
        </div>

        <!-- Period -->
        <div class="col-sm-3">
            <label>Periods :</label>
            <select asp-for="Period" asp-items="Html.GetEnumSelectList<Periods>()" class="form-control"></select>
        </div>

        <!-- Day -->
        <div class="col-sm-3">
            <label>Day :</label>
            <select asp-for="DayId" asp-items="Html.GetEnumSelectList<Days>()" class="form-control"></select>
        </div>

        <!-- Save -->
        <div class="col-sm-3">
            <label style="visibility:hidden;">Save</label>
            <br />
            <button type="submit" class="btn btn-primary">Save</button>
        </div>

    </div>

</form>

<script>
           $('#form-add-exam').submit(function (e) {
        e.preventDefault();

        $('#DivisonId').val($('.slct-free-div-dropdown').val());

        console.log("FORM DATA:", $(this).serialize());

        $.ajax({
            url: '/Student/SubmitTimetable',
            type: 'POST',
            data: $(this).serialize(),
            success: function (res) {
                console.log("RESPONSE:", res);
                AddTimetableSuccess(res);
            },
            error: function (xhr) {
                console.log("ERROR RESPONSE:", xhr.responseText);
                AddTimetableFailed();
            }
        });
    });
</script>

