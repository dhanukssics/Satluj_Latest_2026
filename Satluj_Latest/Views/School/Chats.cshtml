@model Satluj_Latest.Models.ChatsPageVM
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Chats";
    Layout = "~/Views/Shared/_SchoolAdminLayout.cshtml";

    var chatUserId = Context.Session.GetString("ChatUserId") ?? "0";
}

<style>
    body {
        background: #f2f6fb;
    }

    .chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 15px;
        margin-bottom: 10px;
    }

        .chat-header .chat-tabs {
            margin: 0;
        }

        .chat-header input {
            width: 220px;
        }

    .chat-shell {
        padding: 15px;
        height: calc(100vh - 20px);
    }

    .chat-wrapper {
        background: #dfeaf3;
        border-radius: 14px;
        padding: 12px;
        height: 100%;
    }

    .chat-sidebar {
        background: #fff;
        border-radius: 12px;
        height: calc(100vh - 110px);
        overflow: hidden;
    }

    .chat-list {
        list-style: none;
        padding: 10px;
        margin: 0;
        overflow-y: auto;
        height: 100%;
    }

    .chat-content {
        background: #fff;
        border-radius: 12px;
        height: calc(100vh - 110px);
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .chat-item {
        display: flex;
        align-items: center;
        padding: 10px;
        border-radius: 10px;
        cursor: pointer;
        margin-bottom: 6px;
    }

        .chat-item:hover,
        .chat-item.active {
            background: #f1f6ff;
        }

    .chat-avatar-text {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        margin-right: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: #fff;
        background: #4e73df;
        text-transform: uppercase;
    }

    .chat-info {
        flex: 1;
        min-width: 0;
    }

        .chat-info strong {
            display: block;
            font-size: 14px;
        }

        .chat-info p {
            font-size: 12px;
            color: #777;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .unread-badge {
        margin-left: auto;
        min-width: 22px;
        height: 22px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 600;
        padding: 0 6px;
    }

    .chat-empty {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        text-align: center;
        color: #777;
    }

    .chat-box {
        width: 100%;
        padding: 20px;
        display: none;
    }

    .msg {
        padding: 8px 12px;
        margin-bottom: 8px;
        border-radius: 8px;
        max-width: 70%;
        word-break: break-word;
    }

        .msg.sent {
            background: #dcf8c6;
            margin-left: auto;
        }

        .msg.received {
            background: #f1f1f1;
        }

    .msg-time {
        font-size: 10px;
        color: #777;
        margin-top: 3px;
    }

    .class-dropdown {
        padding: 10px;
    }

    #studentList {
        max-height: calc(100vh - 250px);
        overflow-y: auto;
    }
</style>

<div class="chat-shell">
    <div class="container-fluid chat-wrapper">
        <div class="row" style="height:100%;">

            <!-- HEADER -->
            <div class="chat-header">
                <ul class="nav nav-tabs chat-tabs">
                    <li class="active" id="allTabBtn">
                        <a href="javascript:void(0);" onclick="showAllTab()">All</a>
                    </li>

                    <li id="classTabBtn">
                        <a href="javascript:void(0);" onclick="showClassTab()">Classes</a>
                    </li>
                </ul>

                <input type="text"
                       id="chatSearch"
                       class="form-control input-sm"
                       placeholder="Search..."
                       onkeyup="filterChats()" />
            </div>

            <!-- LEFT -->
            <div class="col-md-3 chat-sidebar">

                <div class="tab-content" style="height:100%;">

                    <!-- ALL CHATS -->
                    <div id="allTab"
                         class="tab-pane fade in active"
                         style="height:100%;">

                        <ul class="chat-list" id="allChatList">

                            @foreach (var chat in Model.AllChats)
                            {
                                <li class="chat-item"
                                    onclick="openChat(this,
                                        '@chat.ChatTitle.Replace("'", "\\'")',
                                        @chat.ConversationId)">

                                    <div class="chat-avatar-text">
                                        @(string.IsNullOrWhiteSpace(chat.ChatTitle)
                                                                            ? "?"
                                                                            : chat.ChatTitle.Substring(0, 1))
                                </div>

                                    <div class="chat-info">
                                        <strong>@chat.ChatTitle</strong>
                                        <p>@(chat.LastMessage ?? "No messages yet")</p>
                                    </div>

                                @if (chat.UnreadCount > 0)
                                    {
                                        <span class="badge bg-danger unread-badge">
                                            @chat.UnreadCount
                                        </span>
                                    }
                                </li>
                            }

                        </ul>
                    </div>

                    <!-- CLASS TAB -->
                    <div id="classTab"
                         class="tab-pane fade"
                         style="height:100%;">

                        <div class="class-dropdown">

                            <select id="classSelector"
                                    class="form-control"
                                    onchange="loadStudents()">

                                <option value="">
                                    -- Select Class --
                                </option>

                                @foreach (var cls in Model.TeacherClasses)
                                {
                                    <option value="@cls.ClassId|@cls.DivisionId">
                                        @cls.ClassTitle
                                    </option>
                                }

                            </select>

                        </div>

                        <ul class="chat-list" id="studentList"></ul>

                    </div>

                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-md-9 chat-content">

                <div id="emptyChat" class="chat-empty">
                    <h4>No Conversation Selected</h4>
                    <p>Select a student to start chat</p>
                </div>

                <div id="chatBox" class="chat-box">

                    <h4 id="chatTitle"></h4>

                    <hr />

                    <div id="messages"
                         style="height:350px;
                                overflow-y:auto;
                                border:1px solid #eee;
                                padding:10px;">
                    </div>

                    <div class="input-group" style="margin-top:10px">

                        <input type="text"
                               id="msgInput"
                               class="form-control"
                               placeholder="Type message..." />

                        <span class="input-group-btn">
                            <button class="btn btn-primary"
                                    type="button"
                                    onclick="sendMsg()">
                                Send
                            </button>
                        </span>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        var CURRENT_CHAT_USER_ID = Number('@chatUserId') || 0;

        var currentConversationId = 0;

        var lastMessageId = 0;

        // =========================
        // TABS
        // =========================

        function showAllTab() {

            resetChatView();

            $('#allTab').addClass('in active').show();

            $('#classTab').removeClass('in active').hide();

            $('#allTabBtn').addClass('active');

            $('#classTabBtn').removeClass('active');

            loadAllChats();
        }

        function showClassTab() {

            resetChatView();

            $('#classTab').addClass('in active').show();

            $('#allTab').removeClass('in active').hide();

            $('#classTabBtn').addClass('active');

            $('#allTabBtn').removeClass('active');
        }

        // =========================
        // OPEN CHAT
        // =========================

        function openChat(el, name, conversationId) {

            $('.chat-item').removeClass('active');

            if (el)
                $(el).addClass('active');

            currentConversationId = conversationId;

            lastMessageId = 0;

            $('#emptyChat').hide();

            $('#chatBox').show();

            $('#chatTitle').text(name);

            $('#messages').html('');

            $.post('/School/MarkMessagesRead',
                { conversationId: conversationId });

            loadMessages();
        }

        // =========================
        // LOAD FULL MESSAGES
        // =========================

        function loadMessages() {

            if (currentConversationId === 0)
                return;

            $.get('/School/LoadMessages',
                { conversationId: currentConversationId },
                function (data) {

                    $('#messages').html('');

                    data.forEach(function (m) {

                        var cls = m.isMine
                            ? 'sent'
                            : 'received';

                        $('#messages').append(`
                            <div class="msg ${cls}">
                                <div>${escapeHtml(m.messageText)}</div>
                                <div class="msg-time">${m.time}</div>
                            </div>
                        `);

                        lastMessageId = m.MessageId || 0;
                    });

                    scrollBottom();
                });
        }

        // =========================
        // LOAD NEW MESSAGES
        // =========================

        function loadNewMessages() {

            if (currentConversationId === 0)
                return;

            $.get('/School/LoadNewMessages',
                {
                    conversationId: currentConversationId,
                    lastMessageId: lastMessageId
                },
                function (data) {

                    data.forEach(function (m) {

                        var cls = m.isMine
                            ? 'sent'
                            : 'received';

                        $('#messages').append(`
                            <div class="msg ${cls}">
                                <div>${escapeHtml(m.messageText)}</div>
                            </div>
                        `);

                        lastMessageId = m.MessageId || 0;
                    });

                    scrollBottom();
                });
        }

        // =========================
        // SEND MESSAGE
        // =========================

        function sendMsg() {

            var msg = $('#msgInput').val().trim();

            if (!msg || currentConversationId === 0)
                return;

            $.post('/School/SendMessage',
                {
                    conversationId: currentConversationId,
                    message: msg
                },
                function (res) {

                    if (res.success) {

                        $('#msgInput').val('');

                        loadMessages();

                        loadAllChats();
                    }
                });
        }

        // =========================
        // LOAD CHAT LIST
        // =========================

        function loadAllChats() {

            $.get('/School/GetAllChats',
                function (data) {

                    var html = '';

                    data.forEach(function (chat) {

                        var unread = chat.unreadCount > 0
                            ? `<span class="badge bg-danger unread-badge">
                                    ${chat.unreadCount}
                               </span>`
                            : '';

                        html += `
                            <li class="chat-item"
                                onclick="openChat(
                                    this,
                                    '${escapeJs(chat.chatTitle)}',
                                    ${chat.conversationId})">

                                <div class="chat-avatar-text">
                                    ${getInitial(chat.chatTitle)}
                                </div>

                                <div class="chat-info">
                                    <strong>
                                        ${escapeHtml(chat.chatTitle)}
                                    </strong>

                                    <p>
                                        ${escapeHtml(chat.lastMessage || 'No messages yet')}
                                    </p>
                                </div>

                                ${unread}

                            </li>
                        `;
                    });

                    $('#allChatList').html(html);
                });
        }

        // =========================
        // LOAD STUDENTS
        // =========================

        function loadStudents() {

            var val = $('#classSelector').val();

            if (!val) {

                $('#studentList').html('');

                return;
            }

            var parts = val.split('|');

            $.get('/School/LoadStudentsByClass',
                {
                    classId: parts[0],
                    divisionId: parts[1]
                },
                function (data) {

                    var html = '';

                    data.forEach(function (s) {

                        html += `
                            <li class="chat-item"
                                onclick="openOneToOne(
                                    ${s.studentId},
                                    '${escapeJs(s.studentName)}')">

                                <div class="chat-avatar-text">
                                    ${getInitial(s.studentName)}
                                </div>

                                <div class="chat-info">
                                    <strong>
                                        ${escapeHtml(s.studentName)}
                                    </strong>

                                    <p>
                                        Parent :
                                        ${escapeHtml(s.parentName)}
                                    </p>
                                </div>

                            </li>
                        `;
                    });

                    $('#studentList').html(html);
                });
        }

        // =========================
        // OPEN ONE TO ONE
        // =========================

        function openOneToOne(studentId, name) {

            $.get('/School/OpenOneToOneChat',
                { studentId: studentId },
                function (res) {

                    loadAllChats();

                    openChat(null, name, res.conversationId);
                });
        }

        // =========================
        // POLLING
        // =========================

        setInterval(function () {

            if (currentConversationId !== 0) {

                loadNewMessages();
            }

            loadAllChats();

        }, 3000);

        // =========================
        // SEARCH
        // =========================

        function filterChats() {

            var value = $('#chatSearch').val().toLowerCase();

            $('#allChatList .chat-item').each(function () {

                var title =
                    $(this).find('strong').text().toLowerCase();

                var subtitle =
                    $(this).find('p').text().toLowerCase();

                $(this).toggle(
                    title.includes(value) ||
                    subtitle.includes(value)
                );
            });

            $('#studentList .chat-item').each(function () {

                var title =
                    $(this).find('strong').text().toLowerCase();

                var subtitle =
                    $(this).find('p').text().toLowerCase();

                $(this).toggle(
                    title.includes(value) ||
                    subtitle.includes(value)
                );
            });
        }

        // =========================
        // RESET
        // =========================

        function resetChatView() {

            currentConversationId = 0;

            lastMessageId = 0;

            $('#chatBox').hide();

            $('#messages').html('');

            $('#chatTitle').text('');

            $('#emptyChat').show();

            $('#chatSearch').val('');

            $('.chat-item').removeClass('active');
        }

        // =========================
        // HELPERS
        // =========================

        function scrollBottom() {

            $('#messages')
                .scrollTop($('#messages')[0].scrollHeight);
        }

        function escapeHtml(text) {

            if (!text)
                return '';

            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
        }

        function escapeJs(text) {

            if (!text)
                return '';

            return text.replace(/'/g, "\\'");
        }

        function getInitial(name) {

            if (!name)
                return '?';

            return name.trim().charAt(0).toUpperCase();
        }

        // =========================
        // INIT
        // =========================

        $(document).ready(function () {

            showAllTab();

            $('#msgInput').keypress(function (e) {

                if (e.which === 13) {

                    sendMsg();

                    return false;
                }
            });
        });

    </script>

}