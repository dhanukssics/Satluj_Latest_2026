@model Satluj_Latest.Models.CircularList

@{
    bool IsAdmin = Model.IsAdmin;
}

<thead>
    <tr>
        <th>Slno</th>
        <th>Date</th>
        <th>Circular Head</th>
        <th>Description</th>
        <th>File Path</th>

        @if (IsAdmin)
        {
            <th>#</th>
        }
    </tr>
</thead>

<tbody>

    @{
        int i = 1;
    }

    @if (Model.CircularData != null && Model.CircularData.Any())
    {
        foreach (var item in Model.CircularData)
        {
            var url = !string.IsNullOrEmpty(item.FilePath)
            ? "http://satluj.schoolman.in" + item.FilePath
            : "";

            <tr data-feeid="@item.CircularId">

                <td>@i</td>

                <td>
                    @(item.CircularDate != DateTime.MinValue
                                ? item.CircularDate.ToString("dd/MM/yyyy")
                                : "")
        </td>

                <td>@item.CircularHead</td>

                <td>@item.Description</td>

                <td>
            @if (string.IsNullOrEmpty(item.FilePath))
                    {
                        <p>No Files</p>
                    }
                    else
                    {
                        <a href="@url" target="_blank">Click Here</a>
                    }
                </td>

                @if (IsAdmin)
                {
                    <td>
                        <button class="delete-fee-tr btn btn-peek delete-circular-data"
                                data-id="@item.CircularId">
                            <i class="fa fa-trash"></i>
                        </button>

                        <button class="edit-fee-tr btn pay-now-btn edit-circular-data"
                                data-id="@item.CircularId">
                            <i class="fa fa-edit"></i>
                        </button>
                    </td>
                }

            </tr>

            i++;
        }
    }
    else
    {
        <tr>
            <td colspan="6" style="text-align:center;">
                No Circular Notifications Found
            </td>
        </tr>
    }

</tbody>