@model Satluj_Latest.Models.CalendarEventModels
@{
   
    bool IsAdmin = ViewBag.IsAdmin as bool? ?? false;
}


<thead>
    <tr>
        <th>
            Slno
        </th>
        <th>
            Event Head
        </th>
        <th>
            Event Details
        </th>
        <th>
            Event Date
        </th>
        @if (IsAdmin == true)
        {
            <th> </th>
        }
    </tr>
</thead>
<tbody>
    @if (Model?.CalendarEvents != null && Model.CalendarEvents.Any())
    {
        int i = 1;
        foreach (var cal in Model.CalendarEvents)
        {
            <tr>
                <td>@i</td>
                <td>@cal.EventHead</td>
                <td>@cal.EventDetails</td>
                <td>@cal.EventDate.ToString("dd/MM/yyyy")</td>

                @if (IsAdmin)
                {
                    <td>
                        <button class="delete-category-tr btn-peek" data-id="@cal.EventId">
                            <i class="fa fa-trash"></i>
                        </button>
                        <button class="edit-staff-tr pay-now-btn" data-id="@cal.EventId">
                            <i class="fa fa-edit"></i>
                        </button>
                    </td>
                }
            </tr>
            i++;
        }
    }
    else
    {
        <tr>
            <td colspan="5" style="text-align:center;">No Events Found</td>
        </tr>
    }
</tbody>
