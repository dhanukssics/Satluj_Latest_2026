@model Satluj_Latest.Models.ExamResultMainModel

@{
    ViewBag.Title = "ExamDeclaration";
    Layout = "~/Views/Shared/_SchoolAdminLayout.cshtml";

    bool IsAdmin = ViewBag.IsAdmin != null && Convert.ToBoolean(ViewBag.IsAdmin);
}

@Html.HiddenFor(z => z.SchoolId)
@Html.HiddenFor(z => z.ClassId, new { Value = 0 })
@Html.HiddenFor(z => z.DivisionId, new { Value = 0 })
@Html.HiddenFor(z => z.ExamId, new { Value = 0 })
@Html.HiddenFor(z => z.SubjectId, new { Value = 0 })
@Html.HiddenFor(z => z.ScholasticAreaId, new { Value = 0 })
@Html.HiddenFor(z => z.CoScholasticAreaId, new { Value = 0 })
@Html.HiddenFor(z => z.UserId, new { id = "user-Id" })

<div class="row">
    <div class="col-md-12">
        <h3 style="margin-top: 5px;">Co-Scholastic Area Result</h3>

        @if (IsAdmin)
        {
            <div class="row">
                <div class="form-group col-sm-3">
                    <label>Class :</label>
                    <select asp-for="ClassId"
                            asp-items="Model.ClassList"
                            class="form-control pv_class-drop-down class-drop-down"
                            id="classDataDropdownAdmin">
                        <option value="">--Choose--</option>
                    </select>
                </div>

                <div class="form-group col-sm-3">
                    <label>Division</label>
                    <select id="division-drop-down"
                            class="form-control slct-free-div-dropdown"
                            disabled>
                        <option value="">--Select Division--</option>
                    </select>
                </div>

                <div class="form-group col-sm-3">
                    <label>Exam :</label>
                    <select class="form-control slct-exam-dropdown1" disabled>
                        <option value="">---</option>
                    </select>
                </div>

                <div class="form-group col-sm-3">
                    <label>Co-Scholastic Area :</label>
                    <select class="form-control slct-ScholasticAreaResult-dropdown1" disabled>
                        <option value="">---</option>
                    </select>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="form-group col-sm-3">
                    <label>Class :</label>
                    <select asp-for="ClassId"
                            asp-items="Model.ClassList_wise"
                            class="form-control pv_class-drop-down class-drop-down"
                            id="classDataDropdownNonAdmin">
                        <option value="">--Choose--</option>
                    </select>
                </div>

                <div class="form-group col-sm-3">
                    <label>Division</label>
                    <select id="division-drop-down"
                            class="form-control slct-free-div-dropdown"
                            disabled>
                        <option value="">--Select Division--</option>
                    </select>
                </div>

                <div class="form-group col-sm-3">
                    <label>Exam :</label>
                    <select class="form-control slct-exam-dropdown1" disabled>
                        <option value="">---</option>
                    </select>
                </div>

                <div class="form-group col-sm-3">
                    <label>Co-Scholastic Area :</label>
                    <select class="form-control slct-ScholasticAreaResult-dropdown1" disabled>
                        <option value="">---</option>
                    </select>
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table custome-table" id="declaed-coSo-student-mark-list"></table>
        </div>
    </div>
</div>

<script>

    var isAdmin = @((ViewBag.IsAdmin != null && Convert.ToBoolean(ViewBag.IsAdmin)).ToString().ToLower());

    //---------------------------------------------
    // CLASS CHANGE → LOAD DIVISION
    //---------------------------------------------
    $(document).on('change', '.class-drop-down', function () {

        var classId = $(this).val();
        var schoolId = $('#SchoolId').val();
        var userId = $('#user-Id').val();

        $('#ClassId').val(classId);

        // Always reset lower dropdowns first
        $('#DivisionId').val('');
        $('#ExamId').val('');
        $('#ScholasticAreaId').val('');
        $('#CoScholasticAreaId').val('');

        $(".slct-exam-dropdown1").html('<option value="">---</option>').prop("disabled", true);
        $(".slct-ScholasticAreaResult-dropdown1").html('<option value="">---</option>').prop("disabled", true);
        $('#declaed-coSo-student-mark-list').html('');

        if (classId !== '') {

            var url = isAdmin
                ? '/Data/LoadDivision'
                : '/Data/LoadAllSchoolDivisionUserWise';

            var data = isAdmin
                ? { id: classId }
                : { id: classId, schoolid: schoolId, UserId: userId };

            $.ajax({
                url: url,
                type: "GET",
                data: data,
                success: function (result) {

                    $("#division-drop-down").html('');

                    if (result.list && result.list.length > 0) {

                        $("#division-drop-down").append('<option value="">-- Select Division --</option>');

                        $.each(result.list, function (i, item) {
                            $("#division-drop-down").append(
                                $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                            );
                        });

                        // IMPORTANT: ENABLE division here
                        $("#division-drop-down").prop("disabled", false);
                    }
                    else {
                        $("#division-drop-down").append('<option value="">-- No Division Found --</option>');
                        $("#division-drop-down").prop("disabled", true);
                    }
                },
                error: function () {
                    console.log("Error loading divisions");
                    $("#division-drop-down").html('<option value="">-- No Division Found --</option>');
                    $("#division-drop-down").prop("disabled", true);
                }
            });
        }
        else {
            $("#division-drop-down").html('<option value="">-- Select Division --</option>');
            $("#division-drop-down").prop("disabled", true);
        }
    });




    //---------------------------------------------
    // DIVISION CHANGE → LOAD EXAMS
    //---------------------------------------------
    $(document).on('change', '.slct-free-div-dropdown', function () {

        var divisionId = $(this).val();
        var classId = $('#ClassId').val();
        var schoolId = $('#SchoolId').val();

        $('#DivisionId').val(divisionId);

        // Reset only lower levels first
        $('#ExamId').val('');
        $('#ScholasticAreaId').val('');
        $('#CoScholasticAreaId').val('');

        $(".slct-exam-dropdown1").html('<option value="">---</option>').prop("disabled", true);
        $(".slct-ScholasticAreaResult-dropdown1").html('<option value="">---</option>').prop("disabled", true);
        $('#declaed-coSo-student-mark-list').html('');

        if (divisionId !== '') {

            $.ajax({
                url: '/Data/LoadAllExams',
                type: "GET",
                data: {
                    id: divisionId,
                    schoolid: schoolId,
                    classId: classId
                },
                success: function (result) {

                    $(".slct-exam-dropdown1").html('');

                    if (result.list && result.list.length > 0) {

                        $(".slct-exam-dropdown1").append('<option value="">-- Select Exam --</option>');

                        $.each(result.list, function (i, item) {
                            $(".slct-exam-dropdown1").append(
                                $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                            );
                        });

                        // IMPORTANT: Enable exam here
                        $(".slct-exam-dropdown1").prop("disabled", false);
                    }
                    else {
                        $(".slct-exam-dropdown1").append('<option value="">-- No Exam Found --</option>');
                        $(".slct-exam-dropdown1").prop("disabled", true);
                    }
                },
                error: function () {
                    console.log("Error loading exams");
                    $(".slct-exam-dropdown1").html('<option value="">-- No Exam Found --</option>');
                    $(".slct-exam-dropdown1").prop("disabled", true);
                }
            });
        }
    });

    //---------------------------------------------
    // EXAM CHANGE → LOAD CO-SCHOLASTIC AREAS
    //---------------------------------------------
    $(document).on('change', '.slct-exam-dropdown1', function () {

        var examId = $(this).val();
        var classId = $('#ClassId').val();
        var schoolId = $('#SchoolId').val();

        $('#ExamId').val(examId);

        if (examId !== '') {

            var id = schoolId + '~' + classId + '~' + examId;

            $.ajax({
                url: '/Data/LoadAllCoScholasticAreas',
                type: "GET",
                data: { id: id },
                success: function (result) {

                    $(".slct-ScholasticAreaResult-dropdown1").html('');

                    if (result.list && result.list.length > 0) {

                        $(".slct-ScholasticAreaResult-dropdown1").append('<option value="">-- Select Co-Scholastic Area --</option>');

                        $.each(result.list, function (i, item) {
                            $(".slct-ScholasticAreaResult-dropdown1").append(
                                $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                            );
                        });

                        $(".slct-ScholasticAreaResult-dropdown1").prop("disabled", false);
                    }
                    else {
                        $(".slct-ScholasticAreaResult-dropdown1").append('<option value="">---</option>');
                        $(".slct-ScholasticAreaResult-dropdown1").prop("disabled", true);
                    }

                    $('#declaed-coSo-student-mark-list').html('');
                }
            });
        }
        else {
            resetAfterExam();
        }
    });


    //---------------------------------------------
    // CO-SCHOLASTIC CHANGE → LOAD STUDENTS
    //---------------------------------------------
    $(document).on('change', '.slct-ScholasticAreaResult-dropdown1', function () {

        var scholasticId = $(this).val();

        $('#ScholasticAreaId').val(scholasticId);
        $('#CoScholasticAreaId').val(scholasticId); // IMPORTANT FIX

        var classId = $('#ClassId').val();
        var divisionId = $('#DivisionId').val();
        var examId = $('#ExamId').val();

        if (classId && divisionId && examId && scholasticId) {

            $.ajax({
                url: '/Progress/SudentListForEnterCoScolasticAreaResult/' +
                    examId + '~' + classId + '~' + divisionId + '~' + scholasticId,
                type: "GET",
                success: function (data) {
                    $('#declaed-coSo-student-mark-list').html(data);
                }
            });
        }
        else {
            $('#declaed-coSo-student-mark-list').html('');
        }
    });


    //---------------------------------------------
    // SAVE MARKS
    //---------------------------------------------
    $(document).on('click', '#students-Mark-Save_btn', function () {
        getFullData();
    });

    function getFullData() {

        var dataList = {
            SchoolId: $('#SchoolId').val(),
            ClassId: $('#ClassId').val(),
            DivisionId: $('#DivisionId').val(),
            ExamId: $('#ExamId').val(),
            CoScholasticId: $('#CoScholasticAreaId').val(),
            ListData: []
        };

        $('.cls-tr-class').each(function () {

            var mark = $(this).find('.cls-mark').val();

            dataList.ListData.push({
                StudentId: $(this).attr('data-StudentId'),
                Mark: mark ? mark : 0,
                StudentName: ''
            });
        });

        $.ajax({
            url: "/Progress/SubmitStudentsCoScholasticAreaMarks",
            type: "POST",
            data: dataList,
            success: function (response) {

                if (response.status) {
                    toastrSuccess(response.msg);
                    location.reload();
                }
                else {
                    toastrError(response.msg);
                }
            }
        });
    }


    //---------------------------------------------
    // RESET HELPERS
    //---------------------------------------------
    function resetAfterClass() {

        $("#division-drop-down").prop("disabled", true).html('<option value="">-- Select Division --</option>');
        resetAfterDivision();
    }

    function resetAfterDivision() {

        $(".slct-exam-dropdown1").prop("disabled", true).html('<option value="">---</option>');
        resetAfterExam();
    }

    function resetAfterExam() {

        $(".slct-ScholasticAreaResult-dropdown1").prop("disabled", true).html('<option value="">---</option>');
        $('#declaed-coSo-student-mark-list').html('');
    }

</script>