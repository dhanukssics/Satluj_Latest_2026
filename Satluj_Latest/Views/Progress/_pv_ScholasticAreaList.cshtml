@using Satluj_Latest.Data
@model Satluj_Latest.Models.ScholasticAreaModel

@{
    int x = 1;
    bool IsAdmin = ViewBag.IsAdmin ?? false;
    var data = Model.ScholasticAreaList ?? new List<ScholasticArea>();
}

<table class="table custome-table scholastic-area-list">
    <thead>
        <tr>
            <th>Sl No</th>
            <th>Region</th>
            <th>Scholastic Area</th>
            <th>Score</th>
            @if (IsAdmin)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in data)
        {
            <tr>
                <td>@x</td>
                <td>@item.RegionName</td>
                <td>@item.ItemName</td>
                <td>@item.TotalScore</td>
                @if (IsAdmin)
                {
                    <td>
                        <button class="delete-class-tr btn btn-peek" data-scho="@item.Id">
                            <i class="fa fa-trash"></i>
                        </button>
                        <button class="edit-class-tr btn btn-peek" data-scho="@item.Id">
                            <i class="fa fa-edit"></i>
                        </button>
                    </td>
                }
            </tr>
            x++;
        }
    </tbody>
</table>