@model Satluj_Latest.Models.RemarkModel
@{
    var remarkDetails = Model.RemarkList ?? new List<Satluj_Latest.Data.RemarkClass>();
    bool IsAdmin = ViewBag.IsAdmin ?? false;
}

<thead>
    <tr>
        <th>Slno</th>
        <th>Remark</th>
        @if (IsAdmin)
        {
            <th></th>
        }
    </tr>
</thead>
<tbody>
    @{
        int i = 1;
        foreach (var mark in remarkDetails)
        {
            <tr>
                <td>@i</td>
                <td>@mark.Remark</td>
                @if (IsAdmin)
                {
                    <td>
                        <button class="delete-remark-tr btn btn-peek" data-remarkid="@mark.Id">
                            <i class="fa fa-trash"></i>
                        </button>
                        <button class="edit-remark-tr btn btn-peek" data-remarkid="@mark.Id">
                            <i class="fa fa-edit"></i>
                        </button>
                    </td>
                }
            </tr>
            i++;
        }
    }
</tbody>