@model Satluj_Latest.Models.RemarkModel

@{
    ViewData["Title"] = "Remark";
    Layout = "~/Views/Shared/_SchoolAdminLayout.cshtml";
}

<style>
    .dev-adj-style {
        padding: 3%;
    }
</style>

<div class="row">
    <div class="col-lg-12">
        <h4>Remark</h4>

        <div id="div-account-head">
            <form id="form-add-exam"
                  asp-action="SubmitAddRemark"
                  asp-controller="Progress"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row">
                    <div id="new-account-div">
                        <div class="form-group">
                            <div class="col-lg-12">
                                <br />

                                <input asp-for="Remark"
                                       class="form-control"
                                       placeholder="Remark"
                                       autocomplete="off" />

                                <span asp-validation-for="Remark" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn pay-now-btn" id="btn-Subject">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h4>Remark List</h4>
        <div class="table-responsive">
            <table class="table custome-table" id="table-remark-list">
                <partial name="~/Views/Progress/_pv_RemarkList.cshtml" model="Model" />
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRemarkEdit" tabindex="-1" role="dialog"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).off("submit", "#form-add-exam").on("submit", "#form-add-exam", function (e) {
            e.preventDefault();

            $.ajax({
                url: $(this).attr("action"),
                type: "POST",
                data: $(this).serialize(),
                success: function (result) {
                    if (result.status === true) {
                        toastr.success(result.msg);
                        $('#Remark').val('');
                        RefreshList();
                    } else {
                        toastr.error(result.msg);
                    }
                },
                error: function () {
                    toastr.error('Failed!');
                }
            });
        });

        function RefreshList() {
            $('#modalRemarkEdit').modal('hide');

            $.ajax({
                url: '/Progress/GetRemarkList',
                type: "GET",
                dataType: 'html',
                success: function (data) {
                    if ($.fn.DataTable.isDataTable("#table-remark-list")) {
                        $("#table-remark-list").DataTable().destroy();
                    }

                    $('#table-remark-list').html(data);
                    $("#table-remark-list").DataTable();
                },
                error: function () {
                    toastr.error("Failed to refresh remark list!");
                }
            });
        }

        $(function () {
            $("#table-remark-list").DataTable();
        });

        $(document).on('click', '.delete-remark-tr', function () {
            var id = $(this).data('remarkid');

            $.ajax({
                url: '/Progress/DeleteRemark/' + id,
                type: "GET",
                success: function (data) {
                    if (data.status) {
                        toastr.success(data.msg);
                        RefreshList();
                    } else {
                        toastr.error(data.msg);
                    }
                },
                error: function () {
                    toastr.error("Delete failed!");
                }
            });
        });

        $(document).on('click', '.edit-remark-tr', function () {
            var id = $(this).data('remarkid');

            $.ajax({
                url: '/Progress/RemarkEditPartial/' + id,
                type: "GET",
                success: function (data) {
                    $('#modalRemarkEdit').html(data);
                    $.validator.unobtrusive.parse("#modalRemarkEdit");
                    $('#modalRemarkEdit').modal('show');
                },
                error: function () {
                    toastr.error("Failed to load edit popup!");
                }
            });
        });
    </script>
}