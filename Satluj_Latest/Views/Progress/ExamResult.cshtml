@model Satluj_Latest.Models.ExamResultMainModel

@{
    ViewBag.Title = "ExamDeclaration";
    Layout = "~/Views/Shared/_SchoolAdminLayout.cshtml";

    bool IsAdmin = ViewBag.IsAdmin != null && Convert.ToBoolean(ViewBag.IsAdmin);
    int roleId = ViewBag.RoleId != null ? Convert.ToInt32(ViewBag.RoleId) : 0;
}

@Html.HiddenFor(z => z.SchoolId)
@Html.HiddenFor(z => z.ClassId, new { Value = 0 })
@Html.HiddenFor(z => z.DivisionId, new { Value = 0 })
@Html.HiddenFor(z => z.ExamId, new { Value = 0 })
@Html.HiddenFor(z => z.SubjectId, new { Value = 0 })
@Html.HiddenFor(z => z.UserId, new { id = "user-Id" })

<div class="row">
    <div class="col-md-12">
        <h3 style="margin-top: 5px;">Exam Result</h3>

        @if (IsAdmin)
        {
            <div class="row">
                <div class="form-group col-sm-3">
                    <label>Class :</label>
                    <select asp-for="ClassId"
                            asp-items="Model.ClassList"
                            class="form-control pv_class-drop-down class-drop-down"
                            id="classDataDropdownAdmin">
                        <option value="">--Choose--</option>
                    </select>
                </div>

                <div class="form-group col-sm-3">
                    <label>Division</label>
                    <select id="division-drop-down" class="form-control slct-free-div-dropdown" disabled>
                        <option value="">--Select Division--</option>
                    </select>
                </div>

                <div class="form-group col-sm-3">
                    <label>Exam :</label>
                    <select class="form-control slct-exam-dropdown1" disabled>
                        <option value="">---</option>
                    </select>
                </div>

                <div class="form-group col-sm-3">
                    <label>Subject :</label>
                    <select class="form-control slct-subject-dropdown1" disabled>
                        <option value="">---</option>
                    </select>
                </div>
            </div>

            <div class="row isHidden total-score">
                <div class="form-group col-sm-3">
                    <button type="button" id="student-total-score-save" style="width: 100%;" class="btn pay-now-btn">
                        Total Score
                    </button>
                </div>
            </div>
        }
        else
        {
            if (roleId == 3)
            {
                <div class="row">
                    <div class="form-group col-sm-3">
                        <label>Class :</label>
                        <select asp-for="ClassId"
                                asp-items="Model.ClassList_wise"
                                class="form-control pv_class-drop-down class-drop-downNonAdmin"
                                id="classDataDropdownNonAdmin">
                            <option value="">--Choose--</option>
                        </select>
                    </div>

                    <div class="form-group col-sm-3">
                        <label>Division</label>
                        <select id="division-drop-downNonAdmin" class="form-control slct-free-div-dropdownNonAdmin" disabled>
                            <option value="">--Select Division--</option>
                        </select>
                    </div>

                    <div class="form-group col-sm-3">
                        <label>Exam :</label>
                        <select class="form-control slct-exam-dropdown1NonAdmin" disabled>
                            <option value="">---</option>
                        </select>
                    </div>

                    <div class="form-group col-sm-3">
                        <label>Subject :</label>
                        <select class="form-control slct-subject-dropdown1NonAdmin" disabled>
                            <option value="">---</option>
                        </select>
                    </div>
                </div>

                <div class="row isHidden total-score">
                    <div class="form-group col-sm-3">
                        <button type="button" id="student-total-score-save" style="width: 100%;" class="btn pay-now-btn">
                            Total Score
                        </button>
                    </div>
                </div>
            }
            else
            {
                <br />
                <br />
                <p>You don't have the provision to view the performance!</p>
            }
        }

        <div class="table-responsive">
            <table class="table custome-table" id="declaed-exam-student-mark-list"></table>
        </div>
    </div>
</div>

<div class="modal fade" id="model-view-space" tabindex="-1" role="dialog" aria-labelledby="myModalLabel"></div>

<script>
    //---------------------------------------------
    // ADMIN FLOW
    //---------------------------------------------

    $(document).on('change', '.class-drop-down', function () {
        $('.total-score').addClass('isHidden');

        var classId = $(this).val();
        $('#ClassId').val(classId);

        $('#DivisionId').val('');
        $('#ExamId').val('');
        $('#SubjectId').val('');

        $("#division-drop-down").html('<option value="">-- Select Division --</option>').prop("disabled", true);
        $(".slct-exam-dropdown1").html('<option value="">---</option>').prop("disabled", true);
        $(".slct-subject-dropdown1").html('<option value="">---</option>').prop("disabled", true);
        $('#declaed-exam-student-mark-list').html('');

        if (classId !== '') {
            $.ajax({
                url: '/Data/LoadDivision',
                type: "GET",
                data: { id: classId },
                success: function (result) {
                    $("#division-drop-down").html('');

                    if (result.list && result.list.length > 0) {
                        $("#division-drop-down").append('<option value="">-- Select Division --</option>');
                        $.each(result.list, function (i, item) {
                            $("#division-drop-down").append(
                                $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                            );
                        });
                        $("#division-drop-down").prop("disabled", false);
                    }
                    else {
                        $("#division-drop-down").append('<option value="">-- No Division Found --</option>');
                        $("#division-drop-down").prop("disabled", true);
                    }
                }
            });
        }
    });

    $(document).on('change', '.slct-free-div-dropdown', function () {
        var divisionId = $(this).val();
        var classId = $('#ClassId').val();

        $('#DivisionId').val(divisionId);
        $('#ExamId').val('');
        $('#SubjectId').val('');

        $(".slct-exam-dropdown1").html('<option value="">---</option>').prop("disabled", true);
        $(".slct-subject-dropdown1").html('<option value="">---</option>').prop("disabled", true);
        $('#declaed-exam-student-mark-list').html('');

        if (divisionId !== '') {
            $.ajax({
                url: '/Data/LoadAllExams',
                type: "GET",
                data: {
                    id: divisionId,
                    schoolid: $('#SchoolId').val(),
                    classId: classId
                },
                success: function (result) {
                    $(".slct-exam-dropdown1").html('');

                    if (result.list && result.list.length > 0) {
                        $(".slct-exam-dropdown1").append('<option value="">-- Select Exam --</option>');
                        $.each(result.list, function (i, item) {
                            $(".slct-exam-dropdown1").append(
                                $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                            );
                        });
                        $(".slct-exam-dropdown1").prop("disabled", false);
                    }
                    else {
                        $(".slct-exam-dropdown1").append('<option value="">-- No Exam Found --</option>');
                        $(".slct-exam-dropdown1").prop("disabled", true);
                    }
                }
            });
        }
    });

    $(document).on('change', '.slct-exam-dropdown1', function () {
        $('#declaed-exam-student-mark-list').html('');

        var examId = $(this).val();
        var classId = $('#ClassId').val();

        $('#ExamId').val(examId);
        $('#SubjectId').val('');

        $(".slct-subject-dropdown1").html('<option value="">---</option>').prop("disabled", true);

        if (examId !== '') {
            $.ajax({
                url: '/Data/LoadAllSubjects',
                type: "GET",
                data: { id: examId + '~' + $('#SchoolId').val() + '~' + classId },
                success: function (result) {
                    $(".slct-subject-dropdown1").html('');

                    if (result.list && result.list.length > 0) {
                        $(".slct-subject-dropdown1").append('<option value="">-- Select Subject --</option>');
                        $.each(result.list, function (i, item) {
                            $(".slct-subject-dropdown1").append(
                                $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                            );
                        });
                        $(".slct-subject-dropdown1").prop("disabled", false);
                    }
                    else {
                        $(".slct-subject-dropdown1").append('<option value="">---</option>');
                        $(".slct-subject-dropdown1").prop("disabled", true);
                    }
                }
            });
        }
    });

    $(document).on('change', '.slct-subject-dropdown1', function () {
        var higherSecondaryList = ["XI", "XII", "XI-CS1", "XI-BS", "XI-CC", "XII-CS", "XII-BS", "XII-CC", "XI SCIENCE", "XI COMMERCE", "XI HUMANITIES", "XII SCIENCE", "XII COMMERCE", "XII HUMANITIES"];
        var currentClass = $(".class-drop-down option:selected").text();

        if (currentClass !== '') {
            if (higherSecondaryList.includes(currentClass)) {
                $('.total-score').removeClass('isHidden');
            } else {
                $('.total-score').addClass('isHidden');
            }
        }

        $('#declaed-exam-student-mark-list').html('');
        $('#SubjectId').val($(this).val());

        var classId = $('#ClassId').val();
        var divisionId = $('#DivisionId').val();
        var examId = $('#ExamId').val();
        var subjectId = $('#SubjectId').val();

        if (classId && divisionId && examId && subjectId) {
            $.ajax({
                url: '/Progress/SudentListForEnterResult/' + subjectId + '~' + examId + '~' + classId + '~' + divisionId,
                type: "GET",
                dataType: 'html',
                success: function (data) {
                    $('#declaed-exam-student-mark-list').html(data);
                }
            });
        }
    });

    //---------------------------------------------
    // NON ADMIN FLOW
    //---------------------------------------------

    $(document).on('change', '.class-drop-downNonAdmin', function () {
        $('.total-score').addClass('isHidden');

        var classId = $(this).val();
        $('#ClassId').val(classId);

        $('#DivisionId').val('');
        $('#ExamId').val('');
        $('#SubjectId').val('');

        $("#division-drop-downNonAdmin").html('<option value="">-- Select Division --</option>').prop("disabled", true);
        $(".slct-exam-dropdown1NonAdmin").html('<option value="">---</option>').prop("disabled", true);
        $(".slct-subject-dropdown1NonAdmin").html('<option value="">---</option>').prop("disabled", true);
        $('#declaed-exam-student-mark-list').html('');

        if (classId !== '') {
            $.ajax({
                url: '/Data/LoadAllSchoolDivisionUserWise',
                type: "GET",
                data: {
                    id: classId,
                    schoolid: $('#SchoolId').val(),
                    UserId: $('#user-Id').val()
                },
                success: function (result) {
                    $("#division-drop-downNonAdmin").html('');

                    if (result.list && result.list.length > 0) {
                        $("#division-drop-downNonAdmin").append('<option value="">-- Select Division --</option>');
                        $.each(result.list, function (i, item) {
                            $("#division-drop-downNonAdmin").append(
                                $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                            );
                        });
                        $("#division-drop-downNonAdmin").prop("disabled", false);
                    }
                    else {
                        $("#division-drop-downNonAdmin").append('<option value="">-- No Division Found --</option>');
                        $("#division-drop-downNonAdmin").prop("disabled", true);
                    }
                }
            });
        }
    });

    $(document).on('change', '.slct-free-div-dropdownNonAdmin', function () {
        var divisionId = $(this).val();
        var classId = $('#ClassId').val();

        $('#DivisionId').val(divisionId);
        $('#ExamId').val('');
        $('#SubjectId').val('');

        $(".slct-exam-dropdown1NonAdmin").html('<option value="">---</option>').prop("disabled", true);
        $(".slct-subject-dropdown1NonAdmin").html('<option value="">---</option>').prop("disabled", true);
        $('#declaed-exam-student-mark-list').html('');

        if (divisionId !== '') {
            $.ajax({
                url: '/Data/LoadAllExams',
                type: "GET",
                data: {
                    id: divisionId,
                    schoolid: $('#SchoolId').val(),
                    classId: classId
                },
                success: function (result) {
                    $(".slct-exam-dropdown1NonAdmin").html('');

                    if (result.list && result.list.length > 0) {
                        $(".slct-exam-dropdown1NonAdmin").append('<option value="">-- Select Exam --</option>');
                        $.each(result.list, function (i, item) {
                            $(".slct-exam-dropdown1NonAdmin").append(
                                $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                            );
                        });
                        $(".slct-exam-dropdown1NonAdmin").prop("disabled", false);
                    }
                    else {
                        $(".slct-exam-dropdown1NonAdmin").append('<option value="">-- No Exam Found --</option>');
                        $(".slct-exam-dropdown1NonAdmin").prop("disabled", true);
                    }
                }
            });
        }
    });

    $(document).on('change', '.slct-exam-dropdown1NonAdmin', function () {
        $('#declaed-exam-student-mark-list').html('');

        var examId = $(this).val();
        var classId = $('#ClassId').val();
        var userId = $('#user-Id').val();
        var divisionId = $('#DivisionId').val();

        $('#ExamId').val(examId);
        $('#SubjectId').val('');

        $(".slct-subject-dropdown1NonAdmin").html('<option value="">---</option>').prop("disabled", true);

        if (examId !== '') {
            $.ajax({
                url: '/Data/LoadAllowdedAllSubjects',
                type: "GET",
                data: {
                    id: examId + '~' + $('#SchoolId').val() + '~' + classId + '~' + userId + '~' + divisionId
                },
                success: function (result) {
                    $(".slct-subject-dropdown1NonAdmin").html('');

                    if (result.list && result.list.length > 0) {
                        $(".slct-subject-dropdown1NonAdmin").append('<option value="">-- Select Subject --</option>');
                        $.each(result.list, function (i, item) {
                            $(".slct-subject-dropdown1NonAdmin").append(
                                $('<option>').val(item.value || item.Value).text(item.text || item.Text)
                            );
                        });
                        $(".slct-subject-dropdown1NonAdmin").prop("disabled", false);
                    }
                    else {
                        $(".slct-subject-dropdown1NonAdmin").append('<option value="">---</option>');
                        $(".slct-subject-dropdown1NonAdmin").prop("disabled", true);
                    }
                }
            });
        }
    });

    $(document).on('change', '.slct-subject-dropdown1NonAdmin', function () {
        var higherSecondaryList = ["XI", "XII", "XI-CS1", "XI-BS", "XI-CC", "XII-CS", "XII-BS", "XII-CC", "XI SCIENCE", "XI COMMERCE", "XI HUMANITIES", "XII SCIENCE", "XII COMMERCE", "XII HUMANITIES"];
        var currentClass = $(".class-drop-downNonAdmin option:selected").text();

        if (currentClass !== '') {
            if (higherSecondaryList.includes(currentClass)) {
                $('.total-score').removeClass('isHidden');
            } else {
                $('.total-score').addClass('isHidden');
            }
        }

        $('#declaed-exam-student-mark-list').html('');
        $('#SubjectId').val($(this).val());

        var classId = $('#ClassId').val();
        var divisionId = $('#DivisionId').val();
        var examId = $('#ExamId').val();
        var subjectId = $('#SubjectId').val();

        if (classId && divisionId && examId && subjectId) {
            $.ajax({
                url: '/Progress/SudentListForEnterResult/' + subjectId + '~' + examId + '~' + classId + '~' + divisionId,
                type: "GET",
                dataType: 'html',
                success: function (data) {
                    $('#declaed-exam-student-mark-list').html(data);
                }
            });
        }
    });

    //---------------------------------------------
    // SAVE MARKS
    //---------------------------------------------

    $(document).on('click', '#students-Mark-Save_btn', function () {
        getFullData();
    });

    function getFullData() {
        var dataList = {
            ClassId: $('#ClassId').val(),
            DivisionId: $('#DivisionId').val(),
            SubjectId: $('#SubjectId').val(),
            IsEntered: $('#IsEntered').val(),
            TotalScore: $('#TotalScore').val(),
            SchoolId: $('#SchoolId').val(),
            ExamId: $('#ExamId').val(),
            ListData: []
        };

        $('.cls-tr-class').each(function () {
            var mark = $(this).find('.cls-mark').val();
            var practical = $(this).find('.cls-mark-practical').val();

            dataList.ListData.push({
                StudentId: $(this).attr('data-StudentId'),
                Mark: mark ? parseFloat(mark).toFixed(2) : '0.00',
                PracticalScore: practical,
                StudentName: ''
            });
        });

        $.ajax({
            url: "/Progress/SubmitAddStudentsDeclaredMarks",
            type: "POST",
            dataType: 'json',
            data: dataList,
            success: function (response) {
                if (response.status) {
                    toastrSuccess(response.msg);
                    location.reload();
                } else {
                    toastrError(response.msg);
                }
            }
        });
    }

    //---------------------------------------------
    // TOTAL SCORE MODAL
    //---------------------------------------------

    $(document).on('click', '#student-total-score-save', function () {
        var classId = $('#ClassId').val();
        var divisionId = $('#DivisionId').val();
        var examId = $('#ExamId').val();

        if (classId && divisionId && examId) {
            $.ajax({
                url: '/Progress/ViewStudentsTotalScoreViewPage/' + examId + '~' + classId + '~' + divisionId,
                type: "GET",
                dataType: 'html',
                success: function (data) {
                    $('#model-view-space').html(data);
                    $('#model-view-space').modal('show');
                }
            });
        }
    });

    $(document).on('click', '#btn-Student-total-score-percentage', function () {
        getAllStudentsScoreWIthPercentage();
    });

    function getAllStudentsScoreWIthPercentage() {
        var dataList = {
            ClassIdModel: $('#ClassIdModel').val(),
            DivisionIdModel: $('#DivisionIdModel').val(),
            SchoolIdModel: $('#SchoolIdModel').val(),
            ExamIdModel: $('#ExamIdModel').val(),
            list: []
        };

        $('.cls-tr-classModel').each(function () {
            dataList.list.push({
                StudentId: $(this).attr('data-StudentId'),
                MarkObtained: $(this).find('.cls-MarkObtained').val() ? parseFloat($(this).find('.cls-MarkObtained').val()).toFixed(2) : 0,
                MarkPercentage: $(this).find('.cls-mark-MarkPercentage').val() ? parseFloat($(this).find('.cls-mark-MarkPercentage').val()).toFixed(2) : 0,
                StudentName: ''
            });
        });

        $.ajax({
            url: "/Progress/SubmitStudentsTotalScoreAndPercentage",
            type: "POST",
            dataType: 'json',
            data: dataList,
            success: function (response) {
                if (response.status) {
                    toastrSuccess(response.msg);
                    $('#model-view-space').modal('hide');
                } else {
                    toastrError(response.msg);
                }
            }
        });
    }
</script>